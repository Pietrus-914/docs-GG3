{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GG3",
  "logo": {
    "light": "/logo/gg3-light.svg",
    "dark": "/logo/gg3-dark.svg"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#ACFF2D",
    "light": "#C4FF66",
    "dark": "#8FE600"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "seo": {
    "indexing": "all"
  },
  "navbar": {
    "links": [
      {
        "label": "Home",
        "href": "https://gg3.org/home"
      },
      {
        "label": "Staking",
        "href": "https://panel.gg3.org/"
      },
      {
        "label": "Discord",
        "href": "https://discord.gg/paDyrkccuh"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://gg3.org/home"
    }
  },
  "footer": {
    "socials": {
      "x": "https://twitter.com/GG3_xyz",
      "discord": "https://discord.gg/paDyrkccuh",
      "medium": "https://medium.com/@gg3.xyz"
    }
  },
  "search": {
    "prompt": "Search GG3 docs..."
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "introduction",
              "getting-started/mission-and-vision"
            ]
          },
          {
            "group": "GG3 Overview",
            "pages": [
              "overview/platform-mechanism",
              "overview/gamification",
              "overview/rewards",
              "overview/store",
              "overview/referral-program",
              "overview/dictionary",
              "overview/faq"
            ]
          },
          {
            "group": "GG3 AI Agents",
            "pages": [
              "ai-agents/why-ai-agents",
              "ai-agents/gideon-greylock",
              "ai-agents/swarm-agents"
            ]
          },
          {
            "group": "GGX Tokenomics",
            "pages": [
              "tokenomics/token-description",
              "tokenomics/token-utility",
              "tokenomics/token-distribution",
              "tokenomics/tokens-burn",
              "tokenomics/how-to-get-ggx",
              "tokenomics/staking",
              "tokenomics/liquidity-mining",
              "tokenomics/token-faq"
            ]
          },
          {
            "group": "Airdrop",
            "pages": [
              "airdrop/season-1"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/integration",
              "integrations/postback-s2s"
            ]
          },
          {
            "group": "Community",
            "pages": [
              "community/social-links"
            ]
          }
        ]
      }
    ]
  }
}
